{
  "name": "@vectorvesper/motion",
  "version": "1.2.0",
  "description": "Motion primitives on one shared frame loop — a sensor layer, a frame-budget governor, and React hooks for fast, coordinated interactive sites. Zero dependencies.",
  "license": "MIT",
  "author": "Vector Vesper",
  "homepage": "https://vectorvesper.dev",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "react",
    "devtools",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    },
    "./devtools": {
      "types": "./dist/devtools.d.ts",
      "import": "./dist/devtools.js",
      "require": "./dist/devtools.cjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsup && node scripts/sanitize-dts.mjs && node scripts/preserve-directives.mjs",
    "check:api": "node scripts/check-api.mjs",
    "prepublishOnly": "npm run build && npm run check:api"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^8.5.0",
    "typescript": "^5"
  },
  "keywords": [
    "animation",
    "motion",
    "motion-primitives",
    "primitives",
    "requestAnimationFrame",
    "raf",
    "frame-loop",
    "pointer",
    "scroll",
    "performance",
    "react",
    "runtime",
    "scheduler",
    "devtools",
    "profiler",
    "frame-budget"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
